# dependencies
/node_modules

# next.js
/.next*/
/out/
# generated by next dev/build
next-env.d.ts

# misc
.DS_Store

# local env files
.env.local
.env.*.local
.env

# Log files
*.log*

# vercel
.vercel

# sitecore temp files
.sitecore/*
# except for component-map
!.sitecore/component-map.ts
!.sitecore/component-map.client.ts

# pdf.js browser build copied by scripts/copy-pdf-worker.mjs
/public/pdf.min.mjs
/public/pdf.worker.min.mjs
/public/pdf.sandbox.min.mjs
*.tsbuildinfo
