# Copy to .env.local and fill in. Values marked (Deploy app) come from the environment's
# Developer settings tab in the SitecoreAI Deploy app (Context = Preview for local editing).

# --- SitecoreAI (Deploy app) ---
SITECORE_EDGE_CONTEXT_ID=
# Client-side context id for the Content SDK's browser bundle. Optional: when unset, the build
# falls back to SITECORE_EDGE_CONTEXT_ID (next.config.ts). A scoped context id is the better value here.
NEXT_PUBLIC_SITECORE_EDGE_CONTEXT_ID=
NEXT_PUBLIC_DEFAULT_SITE_NAME=portal
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
SITECORE_EDITING_SECRET=
# Public origin for canonical URLs, sitemaps and JSON-LD (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Content Hub (server-only; never NEXT_PUBLIC_) ---
# Tenant host, e.g. https://my-tenant.sitecorecontenthub.cloud
CH_HOST=
# A dedicated read-only Content Hub user (plus create rights on BrandSite.PortalEvent for usage tracking)
CH_USER=
CH_PASS=
# Experience Edge for Content Hub: delivery GraphQL endpoint + a delivery API key (X-GQL-Token)
EDGE_GRAPHQL_URL=https://edge-beta.sitecorecloud.io/api/graphql/v1
EDGE_TOKEN=

# --- Fallbacks when the Portal Settings item in SitecoreAI is not published yet ---
# Comma-separated Content Hub M.Brand identifiers (empty = every brand)
PORTAL_BRANDS=
PORTAL_TRACK_USAGE=0
PORTAL_SITE_LABEL=sitecoreai-portal
FALLBACK_ACCENT=#9528E6

# Locale mapping: SitecoreAI language ([locale] segment) → Content Hub culture of localized values.
# Default: exact culture, else same language, else CH_DEFAULT_CULTURE. CH_CULTURE_MAP forces pairs.
CH_DEFAULT_CULTURE=en-US
# CH_CULTURE_MAP=en=en-US,de=de-DE
# Extra SitecoreAI languages the head should route (the site's default language is always on).
# NEXT_PUBLIC_EXTRA_LOCALES=de-DE

# On-demand cache revalidation: a Content Hub REST action POSTs /api/revalidate?secret=<this> (32+ random chars).
REVALIDATE_SECRET=

# Optional: the key the Marketplace apps' API calls must carry (picker, setup discovery, Content Hub
# info, health). Set it here AND append ?k=<same key> to each extension point URL in App Studio
# (e.g. https://<head>/ch-picker?k=...). Unset = those APIs stay open to anyone who knows the URL.
# PORTAL_TOOLS_KEY=

# Branding the setup applies (on create, or over untouched defaults): the header's wordmark and
# the Content Hub asset identifier of the Home banner's image (the Demo Builder sets both).
# PORTAL_WORDMARK=
# PORTAL_HERO_ASSET=
# The Home banner's texts per language (written over the setup's default texts only):
# {"en":{"eyebrow":"…","title":"…","text":"…","cta":{"label":"Explore programs","href":"/programs"}},"es-US":{…}}
# PORTAL_HERO=
# The demo's theme, written into Portal Settings → Theme by the setup where still empty (Demo Builder):
# {"b":"<brand>","c":["#primary","#secondary",…],"h":"<heading Google font>","t":"<body Google font>"}
# PORTAL_THEME=

# Hub deployment only (one Marketplace app for every portal site of the environment — doc §5m):
# PORTAL_HUB=1
# NEXT_PUBLIC_PORTAL_HUB=1
# PORTAL_HUB_HEADS=*.vercel.app

# --- Sign-in (phase 2) ---
# public: no login, Content Hub public links | hybrid: public portal + sign-in for pages marked
# "partners"/"staff", every file via /api/asset | gated: everything behind the sign-in.
SITE_MODE=public
# 32+ random characters; signs the session cookie (required for hybrid/gated)
AUTH_SECRET=
# the portal's own (staff) login: PORTAL_PASSWORD_HASH from `node tools/hash-password.mjs` (prompts; or pipe the password in) (or PORTAL_PASSWORD for a demo)
PORTAL_USER=staff
PORTAL_PASSWORD_HASH=
# partner logins: JSON [{"u":"<user>","h":"<hash>"}] (or "p":"<password>" for a demo; optional "l": a second
# sign-in name, the contact person's); profiles are items under <site>/Data/Partners
PORTAL_PARTNERS=[]
# partner uploads (hybrid/gated): the JSON the Demo Builder's portal step prints ({"v":1,"flc":{...},...})
# PORTAL_UPLOADS=

# Files /api/asset streams itself up to this size (bytes, at most 4 MB on Vercel); larger ones redirect to a signed link
# PORTAL_MAX_STREAM_BYTES=
# Log every Content Hub REST call (status and timing) — troubleshooting only
# PORTAL_DEBUG_REST=1

# The editing deployment (preview context id) the Portal setup wizard should register for the Page builder
# PORTAL_EDITING_URL=https://<project>-editing.vercel.app
