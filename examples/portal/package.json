{
  "name": "sitecoreai-content-hub-portal",
  "version": "1.0.0",
  "private": true,
  "config": {
    "appName": "portal",
    "graphQLEndpointPath": "/sitecore/api/graph/edge",
    "language": "en",
    "template": "nextjs"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "2.28.2",
    "@sitecore-content-sdk/analytics-core": "^2.1.2",
    "@sitecore-content-sdk/events": "^2.1.2",
    "@sitecore-content-sdk/nextjs": "^2.4.0",
    "@sitecore-content-sdk/personalize": "^2.1.0",
    "@sitecore-marketplace-sdk/client": "^0.4.0",
    "@sitecore-marketplace-sdk/xmc": "^0.4.3",
    "jose": "6.2.12",
    "leaflet": "1.9.4",
    "linkedom": "^0.18.13",
    "next": "^16.4.2",
    "next-intl": "^4.9.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rsc-env": "0.0.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@sitecore-content-sdk/cli": "^2.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "1.9.21",
    "@types/node": "^24.10.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "cross-env": "^10.0.0",
    "eslint": "^9.33.0",
    "eslint-config-next": "^16.4.2",
    "npm-run-all2": "^8.0.4",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "postcss": ">=8.5.10",
    "picomatch": "4.0.4",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "brace-expansion@^5.0.0": "5.0.12",
    "lodash-es": "4.18.1",
    "flatted": "3.4.2",
    "esbuild": ">=0.28.1"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production npm-run-all --serial sitecore-tools:generate-map sitecore-tools:build next:build",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit --incremental false",
    "test": "node --import tsx --conditions=react-server --test tests/*.test.ts",
    "next:build": "next build",
    "next:dev": "cross-env NODE_OPTIONS='--inspect' next dev",
    "next:start": "next start",
    "sitecore-tools:generate-map": "sitecore-tools project component generate-map",
    "sitecore-tools:generate-map:watch": "sitecore-tools project component generate-map --watch",
    "sitecore-tools:build": "sitecore-tools project build",
    "dev": "cross-env NODE_ENV=development npm-run-all --serial sitecore-tools:generate-map sitecore-tools:build --parallel next:dev sitecore-tools:generate-map:watch",
    "start": "cross-env-shell NODE_ENV=production npm-run-all --serial build next:start",
    "copy-pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "predev": "npm run copy-pdf-worker",
    "prebuild": "npm run copy-pdf-worker"
  }
}
