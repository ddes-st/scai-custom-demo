{
  "name": "bq",
  "description": "BQ (Build Quick) — Sitecore AI / Content SDK Next.js app for rapid PoCs and customized demos",
  "version": "0.2.0",
  "private": true,
  "author": {
    "name": "Sitecore Corporation",
    "url": "https://doc.sitecore.com/sai/en/developers/content-sdk/sitecore-content-sdk-for-sitecoreai.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitecore/content-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/sitecore/content-sdk/issues"
  },
  "license": "Apache-2.0",
  "scripts": {
    "definitions:generate": "tsx tools/definitions/generate.ts",
    "content:generate": "tsx tools/content/generate.ts",
    "authoring:generate": "node tools/authoring-generate.mjs",
    "capture:webpage": "node tools/capture/capture.mjs",
    "capture:merge-sections": "node tools/capture/merge-page-sections.mjs",
    "create:design-system": "node tools/capture/create-design-system.mjs",
    "capture:site-summary": "node tools/capture/write-site-summary.mjs",
    "capture:site-content-tree": "node tools/capture/write-site-content-tree.mjs",
    "capture:section-plans": "node tools/capture/write-section-plans.mjs",
    "create:sectioncomponents": "node --import tsx tools/create-section-components/cli.mjs",
    "create:sectioncomponents:reset": "node --import tsx tools/site-delete.mjs --mode=collection",
    "component:delete": "node --import tsx tools/component-delete.mjs",
    "delete:site": "node --import tsx tools/site-delete.mjs --mode=site",
    "delete:collection": "node --import tsx tools/site-delete.mjs --mode=collection",
    "restore:collection": "node --import tsx tools/restore-collection.mjs",
    "site:delete": "node --import tsx tools/site-delete.mjs",
    "fidelity:component": "node --import tsx tools/create-section-components/fidelity-component-cli.mjs",
    "diagnose:sitecoreize-preview": "node --import tsx tools/create-section-components/diagnose-sitecoreize-preview.mjs",
    "benchmark:layout-models": "node tools/create-section-components/benchmark-models.mjs",
    "setup:playwright": "node tools/setup-playwright.mjs",
    "ensure:host-components": "node tools/shared/ensure-partial-design-dynamic-placeholder.mjs",
    "build": "cross-env NODE_ENV=production npm-run-all --serial sitecore-tools:generate-map sitecore-tools:build next:build",
    "lint": "eslint ./src/**/*.tsx ./src/**/*.ts",
    "next:build": "node tools/shared/clean-next-dev-types.mjs && next build",
    "next:dev": "cross-env NODE_OPTIONS='--inspect' next dev",
    "next:start": "next start",
    "sitecore-tools:generate-map": "npm run ensure:host-components && sitecore-tools project component generate-map",
    "sitecore-tools:generate-map:watch": "sitecore-tools project component generate-map --watch",
    "sitecore-tools:build": "sitecore-tools project build",
    "dev": "cross-env NODE_ENV=development npm-run-all --serial sitecore-tools:generate-map sitecore-tools:build --parallel next:dev sitecore-tools:generate-map:watch",
    "start": "cross-env-shell NODE_ENV=production npm-run-all --serial build next:start"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@cursor/sdk": "^1.0.31",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@shadcn/react": "^0.3.0",
    "@sitecore-content-sdk/analytics-core": "^2.1.2",
    "@sitecore-content-sdk/events": "^2.1.2",
    "@sitecore-content-sdk/nextjs": "^2.4.0",
    "@sitecore-content-sdk/personalize": "^2.1.0",
    "@sitecore-feaas/clientside": "^0.6.0",
    "@sitecore/components": "~2.1.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.32.0",
    "next": "^16.2.0",
    "next-intl": "^4.3.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.1",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.8.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@sitecore-content-sdk/cli": "^2.3.0",
    "@tailwindcss/postcss": "^4",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.0.0",
    "eslint": "^9.33.0",
    "eslint-config-next": "16.2.2",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.62.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "~5.8.3"
  }
}
