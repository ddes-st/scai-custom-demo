# This file should be copied to .env.local and modified with your environment
# variables to connect to your remote Sitecore instance and enable BQ tooling.
# Never commit .env.local (secrets).
#
# Sections:
#   1) Next.js / Sitecore Content SDK (runtime)
#   2) SitecoreAI credentials & CM connection
#   3) Scope generate / authoring
#   4) Azure OpenAI / Foundry (capture + create:sectioncomponents)
#   5) Cultures & translation
#   6) create:sectioncomponents codegen knobs
#   7) Capture browser / Playwright
#   8) Source / visual fidelity
#   9) Media / prune / diagnostics
#  10) Optional experiments & model cost estimates

# -----------------------------------------------------------------------------
# 1) Next.js / Sitecore Content SDK (runtime)
# -----------------------------------------------------------------------------

# To secure the Sitecore editor endpoint exposed by your Next.js app
# (`/api/editing/render` by default), a secret token is used. This (client-side)
# value must match the editing host secret configured in XM Cloud / Deploy.
# Where: Deploy → your environment → rendering host / editing secret, or the
#        value shown when creating the editing host.
SITECORE_EDITING_SECRET=

# On-demand revalidation (`POST /api/revalidate`). Leave empty to skip auth
# (no `x-revalidate-secret` header required).
# When set, webhook/callers must send the same value in the `x-revalidate-secret`
# header. Generate any long random string; keep it private.
SITECORE_REVALIDATE_SECRET=

# Your Sitecore site name (system name of the site item).
# The value represents the default/configured site for the app.
# Where: XM Cloud Pages / Content Editor → site root, or Sites API site `name`
#        (e.g. sitecore-com). Must match NEXT_PUBLIC_DEFAULT_SITE_NAME used at build.
NEXT_PUBLIC_DEFAULT_SITE_NAME=

# Your default app language / culture code (e.g. en).
# Used as the Next.js default locale when no culture is in the URL.
NEXT_PUBLIC_DEFAULT_LANGUAGE=

# Your unified Sitecore Edge Context Id for server-side use.
# This is preferred over older Preview / Delivery Edge variables.
# Where: Deploy → Environment → Edge / Context ID (or XM Cloud portal Edge settings).
SITECORE_EDGE_CONTEXT_ID=

# Your Sitecore Edge Context Id for client-side use.
# Fallback if SITECORE_EDGE_CONTEXT_ID is not provided separately.
# Often the same value as SITECORE_EDGE_CONTEXT_ID for a single environment.
NEXT_PUBLIC_SITECORE_EDGE_CONTEXT_ID=

# Optional: custom Sitecore Edge Platform hostname (hostname or full URL).
# Leave empty to use the default Edge platform host for your region.
NEXT_PUBLIC_SITECORE_EDGE_PLATFORM_HOSTNAME=

# Non-public alias for Edge platform hostname (igql / server helpers). Prefer the
# NEXT_PUBLIC_ form for the app; set this only if a tool reads the server-side name.
# SITECORE_EDGE_PLATFORM_HOSTNAME=

# Optional: custom Experience Edge hostname for media URL rewriting (e.g. staging).
# Leave empty unless you need media URLs rewritten to a non-default Edge host.
SITECORE_EXPERIENCE_EDGE_HOSTNAME=

# An optional Sitecore Personalize scope identifier.
# Isolates personalization data when multiple XM Cloud Environments share a
# Personalize tenant. Should match PAGES_PERSONALIZE_SCOPE for your environment.
NEXT_PUBLIC_PERSONALIZE_SCOPE=

# Browser CDP / Events SDK (pageView, IDENTITY, custom events).
# CDP/Events are ON by default (including local `npm run dev`). Set to false to
# disable browser pageView/identity/events.
# Also requires NEXT_PUBLIC_SITECORE_EDGE_CONTEXT_ID. DOM Security demo IDENTITY
# uses identifiers.provider "userId" to match the tenant Identity rule.
#NEXT_PUBLIC_CDP_EVENTS_ENABLED=false

# Timeout (ms) for Sitecore CDP requests to respond within. Default is 400.
PERSONALIZE_MIDDLEWARE_CDP_TIMEOUT=

# Timeout (ms) for Sitecore Experience Edge requests to respond within. Default is 400.
PERSONALIZE_MIDDLEWARE_EDGE_TIMEOUT=

# Sitecore Content SDK npm packages utilize the debug module for debug logging.
# https://www.npmjs.com/package/debug
# Set the DEBUG environment variable to 'content-sdk:*' to see all logs:
#DEBUG=content-sdk:*
# Or be selective and show for example only layout service logs:
#DEBUG=content-sdk:layout
# Or everything BUT layout service logs:
#DEBUG=content-sdk:*,-content-sdk:layout

# -----------------------------------------------------------------------------
# 2) SitecoreAI credentials & CM connection — where to get each value
# Deploy app: https://deploy.sitecorecloud.io  (or your org’s Deploy URL)
# Docs: https://doc.sitecore.com/sai/en/developers/sitecoreai/deploying-sitecoreai/deploy-app/managing-sitecoreai-client-credentials/manage-client-credentials-for-a-sitecoreai-organization-or-environment.html
# -----------------------------------------------------------------------------

# Environment automation client — used by Content SDK tooling and BQ Sites API
# (create/update collections & sites) plus non-interactive CLI login for ser pull/push.
# Where (exact path):
#   1. Open Deploy app → left nav → Credentials
#   2. Open the Environment tab (not Organization)
#   3. Create credentials → Automation
#   4. Pick your Project + Environment (e.g. jbe-showcase / jbe-showcase)
#   5. Copy Client ID + Client secret once (secret is shown only at creation)
# Wrong type: Organization automation clients get xmclouddeploy.* scopes and fail Sites API.
SITECORE_AUTH_CLIENT_ID=
SITECORE_AUTH_CLIENT_SECRET=

# Rendering host name registered for this app in XM Cloud / Deploy (if required
# by your local or remote editing setup). Leave empty when not applicable.
SITECORE_RENDERINGHOST_NAME=

# SitecoreAI environment id (CM / XM Apps REST). Required for Sites API calls.
# Where:
#   Deploy → Projects → <project> → Environments → <env> → Details / overview
#   Or: CM host URL / environment card in Deploy (id looks like a short alphanumeric string).
# Example shape (not a secret): 7fXKks8vHFxRyAPkiethk0
BQ_SITECORE_ENVIRONMENT_ID=
# Alias accepted by tooling (same value as BQ_SITECORE_ENVIRONMENT_ID):
# SITECORE_ENVIRONMENT_ID=

# Named Sitecore CLI endpoint from repo-root .sitecore/user.json (used by
# definitions:generate for `dotnet sitecore ser pull|push -n <name>`).
# Must match an endpoint with allowWrite: true (e.g. bqAuthoring).
# Override per run: npm run definitions:generate -- --endpoint bqAuthoring
BQ_SITECORE_ENDPOINT=bqAuthoring

# XM Apps / Sites REST base URL. Default: https://xmapps-api.sitecorecloud.io
# Override only for non-prod / regional API hosts.
# BQ_SITES_API_BASE=https://xmapps-api.sitecorecloud.io

# -----------------------------------------------------------------------------
# 2b) Sitecore Stream brand kit (optional — create:sectioncomponents)
# Brand Management API: https://api-docs.sitecore.com/ai-skills/ai-brand-management-rest-api
# Publish = Documents API upload + BrandIngestionPipeline (same Stream AI credentials):
#   https://api-docs.sitecore.com/ai-skills/ai-document-management-rest-api
#   https://api-docs.sitecore.com/ai-skills/ai-pipeline-rest-api
# Create sets `logo` from capture HTML when a public PNG/JPEG URL is found.
# Requires Stream Premium. Credentials: Stream → Admin → AI API keys
# (scopes ai.org.brd:*, ai.org.docs:*).
# Organization id: Cloud Portal URL query `organization=org_…`
# CLI: --brandkit / --no-brandkit (CLI wins over env). Default off.
# -----------------------------------------------------------------------------
BQ_CREATE_BRANDKIT=false
SITECORE_ORGANIZATION_ID=
SITECORE_STREAM_AI_CLIENT_ID=
SITECORE_STREAM_AI_CLIENT_SECRET=
# Optional Brand Management API base (default edge-platform …/ai/ai-brands-api):
# BQ_BRANDS_API_BASE=https://edge-platform.sitecorecloud.io/ai/ai-brands-api
# Optional Documents / Pipeline API bases:
# BQ_DOCUMENTS_API_BASE=https://edge-platform.sitecorecloud.io/ai/ai-document-api
# BQ_PIPELINE_API_BASE=https://edge-platform.sitecorecloud.io/ai/ai-pipeline-api
# Optional Azure prompt size cap for brandkit draft (falls back to AZURE_AI_DESIGN_MAX_CHARS):
# BQ_BRANDKIT_MAX_CHARS=120000

# Escape hatch: allow interactive CLI token for Sites API (debug only).
# Default off — automation client is required. Values: 1
# BQ_SITECORE_ALLOW_INTERACTIVE_TOKEN=1

# Shared Sitecore connection retries (CLI login, CM lookup, ser push network).
# Retries after the first failed attempt (total attempts = 1 + this).
# BQ_SITECORE_CONNECTION_MAX_RETRIES=3
# Delay between retries in ms. Default 5000.
# BQ_SITECORE_CONNECTION_RETRY_DELAY_MS=5000

# -----------------------------------------------------------------------------
# 3) Scope generate / authoring (optional)
# -----------------------------------------------------------------------------

# Scope definitions:generate / content:generate to one site and/or collection
# (also passed automatically by create:sectioncomponents).
# Prefer URL (hostname → site + collection): www.sitecore.com → sitecore-com / sitecore
# BQ_GENERATE_URL=https://www.sitecore.com
# Or: npm run definitions:generate -- --url "https://www.sitecore.com"
# Explicit overrides:
# BQ_GENERATE_SITE=sitecore-com
# BQ_GENERATE_COLLECTION=sitecore
# Or: npm run definitions:generate -- --site sitecore-com

# Optional definitionKey allowlist (comma/space-separated). When the env key is
# *present* (even empty), allowlist mode is on: always emit collection/site/
# presentation/infra + only listed component definitionKeys.
# Usually set automatically by create:sectioncomponents --only; set by hand for
# a narrow definitions:generate.
# BQ_GENERATE_DEFINITION_KEYS=energyprice-multi-brand-header,energyprice-energy-comparison

# Capture page directory for Home + Header/Footer Partial Design thumbnail wiring
# during site / presentation emit (desktop-clean.png and section-*-desktop.png).
# Usually set automatically by create:sectioncomponents phase 3 and final generate
# (do not set by hand unless debugging emit). Example shape: absolute path under
# .bq/captures/<host>/<page>
# BQ_CAPTURE_PAGE_DIR=

# Canonical site origin when multi-host captures are ambiguous (Home link ensure).
# Example: https://www.energyprice.be
# BQ_SITE_ORIGIN=

# Page / source language hint for authoring helpers (culture code, e.g. en or nl-BE).
# BQ_PAGE_LANGUAGE=
# BQ_SOURCE_LANGUAGE=

# -----------------------------------------------------------------------------
# 4) Azure OpenAI / Foundry (capture AI + create:sectioncomponents)
# -----------------------------------------------------------------------------

# Azure OpenAI (or Foundry-backed OpenAI) API key for chat/completions used by
# capture AI, create:sectioncomponents codegen, translation fallback, fidelity.
# Where: Azure Portal → your Azure OpenAI / AI Foundry resource → Keys and Endpoint.
# Alternate key name accepted by some tools: AZURE_FOUNDRY_API_KEY (same value OK).
AZURE_OPENAI_API_KEY=

# Azure OpenAI endpoint URL (OpenAI-compatible base, often …/openai/v1).
# Where: Azure Portal → Azure OpenAI resource → Keys and Endpoint, or Foundry
#        project OpenAI endpoint. Example shape:
#        https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=

# Default chat deployment / model name for BQ AI calls (codegen, translate, etc.).
# Must match a deployment name in your Azure OpenAI / Foundry project.
AZURE_OPENAI_DEFAULT_MODEL=gpt-5.6-luna

# Multimodal screenshot → TSX deployment for create:sectioncomponents.
# Falls back to AZURE_OPENAI_DEFAULT_MODEL when unset.
AZURE_OPENAI_SCREENSHOT_CONVERSION_MODEL=gpt-5.6-luna

# Which Sitecore AI viewport crops to capture, send as AI evidence, and shoot/score
# during visual fidelity (create:sectioncomponents / fidelity:component).
# Keys: mobile, tablet, desktop (Desktop Small 1024), desktopRegular (1280), desktopLarge (1536).
# Unset or empty → mobile,tablet,desktop only. Example for all five:
# BQ_SCREENSHOT_VIEWPORTS=mobile,tablet,desktop,desktopRegular,desktopLarge
# BQ_SCREENSHOT_VIEWPORTS=mobile,tablet,desktop

# Codegen/decompose evidence mode (default html).
#   html — CSS-inlined section.html; no viewport PNG attachments (lower cost)
#   png  — original-section.html + viewport PNG attachments (screenshots lead visuals)
# Aliases: html-leading, png-leading. Fidelity scoring still loads PNGs when
# BQ_SOURCE_FIDELITY / BQ_VISUAL_FIDELITY is on.
# BQ_CODEGEN_EVIDENCE_MODE=html
# BQ_CODEGEN_EVIDENCE_MODE=png

# Codegen: visual-first then Sitecoreize (section HTML/PNG → molecule packages).
# Prefer these over legacy BQ_TSX_GENERATION.
# Max composite depth for sitecoreize packages (default 2).
# BQ_CODEGEN_MAX_DEPTH=2
# Infer responsive Tailwind from HTML when evidence mode=html (default 1 = on).
# BQ_CODEGEN_INFER_RESPONSIVE=1

# Mutating TSX/definition fixups are skipped by default (prompt-first)
# unless this is set. Values: 1 | true (or CLI --v2-fixups). Unset = prompt-first.
# BQ_CODEGEN_V2_FIXUPS=1

# Optional stronger model for source/visual fidelity scoring.
# Falls back to AZURE_OPENAI_SCREENSHOT_CONVERSION_MODEL, then AZURE_OPENAI_DEFAULT_MODEL.
# AZURE_OPENAI_SOURCE_FIDELITY_MODEL=

# Comma-separated deploys for npm run benchmark:layout-models
# (plus conversion model as baseline).
# AZURE_OPENAI_BENCHMARK_MODELS=

# Azure AI Foundry project API key (accepted as alternate to AZURE_OPENAI_API_KEY
# by capture design-system AI helpers).
# Where: Azure AI Foundry → project → Keys / connection strings.
AZURE_FOUNDRY_API_KEY=

# Azure AI Foundry project endpoint (accepted as alternate to AZURE_OPENAI_ENDPOINT
# by some capture helpers). Example shape:
#   https://<resource>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_FOUNDRY_ENDPOINT=

# Optional char budgets for capture AI helpers (design guide / decide-merge).
# AZURE_AI_DESIGN_MAX_CHARS=
# AZURE_AI_DECIDE_MAX_CHARS=   # falls back to AZURE_AI_DESIGN_MAX_CHARS when unset

# -----------------------------------------------------------------------------
# 5) Cultures & translation
# -----------------------------------------------------------------------------

# Sitecore cultures for definition content seeds (comma-separated culture codes).
# Used by capture:webpage / create:sectioncomponents / authoring:generate when
# CLI `--cultures` is not passed. Example: nl-BE,fr-BE
# Empty (BQ_CULTURES=) means no extra cultures beyond en + source.
BQ_CULTURES=nl-BE,fr-BE

# Collection/site *display* brand casing from hostname (systemName stays lowercase).
# title (default) → Sitecore | upper → SITECORE | lower → sitecore
# BQ_BRAND_LABEL_CASE=title

# MyMemory API contact email (de=) — raises free daily char quota (anonymous 5k → 50k).
# Used by authoring:generate / create:sectioncomponents translation; OpenAI is the quota fallback.
BQ_MYMEMORY_EMAIL=

# Culture / EN-seed translation uses Azure OpenAI (same AZURE_OPENAI_* above) as fallback.
# Disk cache: .bq/definitions/cache/translations.json — bypass with BQ_FORCE_TRANSLATIONS=1
# or --force:translations on create:sectioncomponents / authoring:generate.
# BQ_FORCE_TRANSLATIONS=

# Translation cache logging: silent|off = quiet; verbose|1|all = extra detail;
# unset / 0 / false / misses = default miss logging.
# BQ_TRANSLATE_CACHE_LOG=silent

# -----------------------------------------------------------------------------
# 6) create:sectioncomponents codegen knobs
# -----------------------------------------------------------------------------

# Legacy two-stage / one-stage switch (unused; codegen is visual → sitecoreize).
# Values: two_stages | one_stage
# BQ_TSX_GENERATION=one_stage

# When true, keep intermediate visual-only TSX artifacts
# (useful for debugging the visual stage).
# BQ_KEEP_VISUAL_TSX=true

# Which icon library to prefer for generic UI chrome (chevrons, hamburger, arrows)
# in generated TSX. Read by ai-codegen; injected into the codegen prompt.
# Values (case-insensitive):
#   fa | fontawesome | font-awesome  → Font Awesome (project FaIcon helper) — DEFAULT
#   lucide                          → lucide-react for UI chrome only
# When unset or empty → fa.
# HARD: social / Icon Link List brand glyphs ALWAYS use project FaIcon + FA brands
# ids (facebook, instagram, …) regardless of this variable. Lucide never replaces
# brand icons.
# BQ_UI_ICON_LIBRARY=fa
# BQ_UI_ICON_LIBRARY=lucide

# AI validate loop after codegen (create:sectioncomponents):
# Detect-only codegen contracts + tsc; feed failures back to AI; Prettier only when clean.
# 0 = disabled (legacy write + mechanical fixups). 1–3 = max attempts. Default 3.
# CLI: --tsx-validate-max-iters=N
# BQ_TSX_VALIDATE_MAX_ITERS=3

# Definition parse / seed-shape repair retries after finalizeDefinitionTs fails.
# Semantics = retry count (not total attempts): 0 = no retry, 1 = one retry (default), 2–3 = more.
# CLI: --definition-validate-max-iters=N
# BQ_DEFINITION_VALIDATE_MAX_ITERS=1

# Cookie banner layout placement (create:sectioncomponents):
# none (default when unset) = still codegen the component (availableRenderings)
# but do not add it to any page or partial layout.
# place = wire onto page/partial with existing band-cut logic.
# CLI: --cookiebanner-placement=place|none (overrides this env).
# BQ_COOKIEBANNER_PLACEMENT=none

# Skip TSX/client warn-only pass (definition identity/parse gates still run).
# Values: 1 | true | yes
# BQ_SKIP_AI_SOURCE_FIXUPS=1

# Allow definition seed salvage rewrites (inject/remap missing seeds from HTML).
# Default off. Values: 1 | true
# BQ_ALLOW_SEED_SALVAGE=1

# Repeating link lists as composite packages (parent PH + link-item children).
# Default off → Multi-Line Text JSON bags `{ text, url }[]`.
# Values: 1 | true to enable; 0 | false | unset = JSON bags.
# BQ_LINK_LIST_AS_COMPOSITE=1

# Write pre-fixup AI dumps under sections/.../ai-debug/ (prompts, raw JSON, after-fixups).
# Default on when unset. Disable with 0 | false | off | no, or BQ_SKIP_AI_DEBUG=1
# (also CLI --skip-ai-debug).
# BQ_AI_DEBUG_DUMP=0
# BQ_SKIP_AI_DEBUG=1

# -----------------------------------------------------------------------------
# 7) Capture browser / Playwright
# -----------------------------------------------------------------------------

# Playwright headless capture. Values: 1 = headless (typical CI/local default for scripts).
# CAPTURE_HEADLESS=1

# Playwright browser channel. Default chrome when unset.
# CAPTURE_CHANNEL=chrome

# Filter interactive-state menu capture (string match). Leave unset for all menus.
# BQ_MENU_FILTER=

# Browser download/install directory. Default: <bq>/.playwright (durable).
# Cursor sandbox may inject a temp PLAYWRIGHT_BROWSERS_PATH — BQ tooling
# ignores ephemeral cursor-sandbox-cache paths and re-pins to .playwright.
# Set a non-temp path here only if you keep browsers elsewhere.
# Install with: npm run setup:playwright
# PLAYWRIGHT_BROWSERS_PATH=

# Alternate path to an existing Playwright install (module resolve override).
# PLAYWRIGHT_MODULE_PATH=

# -----------------------------------------------------------------------------
# 8) Source / visual fidelity (create:sectioncomponents + fidelity:component)
# -----------------------------------------------------------------------------

# Source fidelity (create:sectioncomponents --source-fidelity[=N]
# or fidelity:component --source-fidelity[=N]):
# Scores generated TSX text against capture crops (no render) and patches TSX
# in place until score ≥ N or max iters. OFF by default.
# Enable with true/false, 1/0, or yes/no (case-insensitive):
# BQ_SOURCE_FIDELITY=true
# Minimum perceptual score 1–100 to accept the TSX (CLI --source-fidelity=N wins).
# BQ_SOURCE_FIDELITY_MIN_SCORE=90
# Max score→patch→re-score rounds (0–3). 0 = never run (overrides --source-fidelity). Default 3.
# 1 = score once and try to patch once. Default 3.
# BQ_SOURCE_FIDELITY_MAX_ITERS=3

# Visual fidelity (create:sectioncomponents --visual-fidelity[=N]
# or fidelity:component --visual-fidelity[=N]):
# Codegen: runs AFTER plain visual TSX and BEFORE sitecoreize — scores/
# repairs the visual-only TSX (Tailwind/layout; no Sitecore language). Shots
# land under sections/<section>/visual-fidelity/<Name>/attempt-*.
# fidelity:component: still renders the written Sitecore package,
# screenshots it, scores vs crops, and surgically repairs on fail.
# Candidate viewports follow BQ_SCREENSHOT_VIEWPORTS (same keys as capture evidence).
# OFF by default. When both source and visual are on, visual wins for that component.
# Enable with true/false, 1/0, or yes/no (case-insensitive):
# BQ_VISUAL_FIDELITY=true
# Minimum perceptual score 1–100 to accept the render (CLI --visual-fidelity=N wins).
# BQ_VISUAL_FIDELITY_MIN_SCORE=95
# Max score→repair→re-score rounds (0–3). 0 = never run (overrides --visual-fidelity).
# 1 = score once, repair once, re-score. Default 3.
# BQ_VISUAL_FIDELITY_MAX_ITERS=3
# One-component only (no YAML / pull / push):
# npm run fidelity:component -- --component SitecoreCardGrid --url "https://www.sitecore.com/" --visual-fidelity=95

# When visual fidelity AI is off, still take Playwright candidate shots of rendered
# packages (sitecoreize-proof / attempt shots). Default on when unset.
# Disable with 0 | false | no.
# BQ_VISUAL_CAPTURE_ONLY=false

# -----------------------------------------------------------------------------
# 9) Media / prune / diagnostics
# -----------------------------------------------------------------------------

# Force media blob rewrite / re-upload instead of early reuse of existing media.
# Values: 1 | true | yes
# BQ_MEDIA_FORCE_REFRESH=1

# Skip orphan / empty-folder / unresolvable-template BQ prune during
# definitions:generate / heal. Values: 1 | true (any truthy skip).
# BQ_SKIP_PRUNE=1

# Allow CM delete fallback when Path/Parent align fails during ser push heal.
# Default off. Values: 1 | true
# BQ_CM_ALIGN_DELETE_FALLBACK=1

# Max relative item path length before SCS hash shortening (matches sitecore.json).
# Default 100.
# BQ_SCS_MAX_RELATIVE_ITEM_PATH_LENGTH=100

# Verbose create / id-resolve logging. Values: verbose (or CLI --verbose).
# BQ_CREATE_LOG=verbose

# Internal/debug (rarely set by hand — tooling may set these for a run):
# Serialization ops log path for a create/generate run.
# BQ_SER_OPS_LOG=
# Nested phase-log depth bookkeeping.
# BQ_PHASE_NEST=
# Run start timestamp (ms) for elapsed logging.
# BQ_RUN_T0=

# -----------------------------------------------------------------------------
# 10) Optional / unused by default BQ path
# -----------------------------------------------------------------------------

# Is not used — Cursor API key (optional design-system classify experiments only).
# Where: https://cursor.com → account / API keys. Leave empty for normal BQ create/capture.
CURSOR_API_KEY=

# Is not used — default Cursor model id when CURSOR_API_KEY is set (e.g. composer-2.5).
CURSOR_DEFAULT_AI_MODEL=

# Is not used — Vercel v0 API key (pixel-perfect experiment M17 only).
# Where: https://v0.dev → account API keys. Not required for create:sectioncomponents.
V0_API_KEY=

# -----------------------------------------------------------------------------
# Model cost estimates (optional)
# -----------------------------------------------------------------------------

# Retail Prices cached under repo .bq/; optional negotiated Price Sheet.
# AZURE_MODEL_RATES_TTL_DAYS=7
# AZURE_MODEL_RATES_CACHE_PATH=   # default: <repo>/.bq/azure-model-rates.json
# Optional org rates (all required together; soft-falls back to Retail on failure):
# AZURE_BILLING_ACCOUNT_NAME=
# AZURE_BILLING_PROFILE_NAME=
# AZURE_ACCESS_TOKEN=             # or `az login` + az account get-access-token
# AZURE_PRICE_SHEET_API_VERSION=2025-03-01
